# PostgreSQL connection string (required)
# For local dev: postgresql://user:password@localhost:5432/tradewave
# For Vercel Postgres / Neon: use the connection string from the dashboard
DATABASE_URL="postgresql://user:password@localhost:5432/tradewave"

JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
NEXT_PUBLIC_SITE_NAME="TradeWave"

# Vercel Blob (required for image uploads in production)
# Auto-injected when you add Vercel Blob from the dashboard
# BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# CoinGecko Demo API key (optional, raises rate limits for the live ticker + /price page)
# Get one at https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY="CG-xxxxxxxxxxxxxxxxxxxxxxxx"

# Sanity CMS (required for content)
# Create a project at https://sanity.io/manage → get projectId from there
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
# Webhook secret for on-demand revalidation (generate any random string)
SANITY_WEBHOOK_SECRET="your-webhook-secret"

# Article Publishing API Key (for /api/publish endpoint)
# Generate any random string, e.g.: openssl rand -hex 32
PUBLISH_API_KEY="your-publish-api-key"

# Resend (optional, for newsletter delivery)
# RESEND_API_KEY="re_..."

# Seed account passwords (used by `npm run db:seed`)
# Set strong values here; never commit real passwords.
SEED_ADMIN_PASSWORD="dev-admin-change-me"
SEED_EDITOR_PASSWORD="dev-editor-change-me"
SEED_AUTHOR_PASSWORD="dev-author-change-me"
