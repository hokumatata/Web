# PostgreSQL connection string (required)
# For local dev: postgresql://user:password@localhost:5432/forex_republic
# For Vercel Postgres / Neon: use the connection string from the dashboard
# Schema migrations are NOT applied during `npm run build` / Vercel deploy.
# Apply them as a separate controlled step:
#   DATABASE_URL="..." npx prisma migrate deploy
DATABASE_URL="postgresql://user:password@localhost:5432/forex_republic"

JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
NEXT_PUBLIC_SITE_NAME="The Forex Republic"
# Canonical public origin — must be the www URL in Vercel Production.
# Used by absUrl, sitemap, robots host, Open Graph, and JSON-LD.
NEXT_PUBLIC_SITE_URL="https://www.theforexrepublic.com"

# Google Analytics 4 (gtag.js). Optional — production defaults to G-T7J6SHB5MC.
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-T7J6SHB5MC"

# OpenAI (required for AI-assisted article drafting)
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."
# Optional: override the model used for drafting (default: gpt-4o-mini)
# OPENAI_MODEL="gpt-4o-mini"
# AI image generation (OPENAI_IMAGE_*) has been removed. Upload covers manually
# via the article editor (Vercel Blob) instead.

# Vercel Blob (required for manual image uploads in production)
# Article covers must be publicly readable — use a dedicated public store token.
# PUBLIC_BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# COVER_BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# Auto-injected when you add Vercel Blob from the dashboard (private stores cannot serve covers)
# BLOB_READ_WRITE_TOKEN="vercel_blob_..."

# CoinGecko Demo API key (optional, raises rate limits for the live ticker + /price page)
# Get one at https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY="CG-xxxxxxxxxxxxxxxxxxxxxxxx"

# Sanity CMS (required for content)
# Create a project at https://sanity.io/manage → get projectId from there
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
# Webhook secret for on-demand revalidation (generate any random string)
SANITY_WEBHOOK_SECRET="your-webhook-secret"

# Article Publishing API Key (for /api/publish endpoint)
# Generate any random string, e.g.: openssl rand -hex 32
PUBLISH_API_KEY="your-publish-api-key"

# Scheduled feed-drafting automation (Vercel Cron -> /api/cron/draft-from-feeds)
# CRON_SECRET is sent by Vercel Cron as `Authorization: Bearer <CRON_SECRET>`.
# Generate: openssl rand -hex 32
# CRON_SECRET="your-cron-secret"
# Max articles written per run (default 3, hard-capped at 10) — controls spend.
# One article can cover several outlets' reports, since related feed items are
# clustered into a single story before writing.
# SOURCE_DRAFTS_PER_RUN="3"
# Newsworthiness threshold, 0-100 (default 45). Clustered stories scoring below
# this are recorded as seen and never sent to the model, so off-topic and
# low-value items cost nothing. Raise it for fewer, stronger pieces.
# SOURCE_MIN_SCORE="45"
# SOURCE_GENERATE_IMAGES is unused — scheduled AI cover generation was removed.
# Author the drafts are attributed to (must exist as an AUTHOR+; default below).
# SOURCE_AUTHOR_EMAIL="masteruser@theforexrepublic.com"
# Override the source feeds (comma-separated "Name|url"). Defaults to a mix of
# analyst commentary (ActionForex, ForexLive), markets news (Investing.com, CNBC,
# Yahoo Finance), crypto (CoinGape, Cointelegraph) and primary central-bank
# releases (Fed, ECB, BoE) — see src/lib/sources.ts. (FXStreet is
# Cloudflare-blocked and Bloomberg has no free feed, so neither can be fetched.)
# An entry may name its beat as a third field to keep coverage balanced across
# desks: "Name|url|forex" with one of forex, crypto, commodities, equities, macro.
# SOURCE_RSS_FEEDS="CoinGape|https://coingape.com/feed/|crypto,ForexLive|https://www.forexlive.com/feed/|forex"
# Every agent draft goes to the admin Review Queue (status REVIEW) with an
# automated due-diligence check and never auto-publishes — a human approves it.

# Breaking wire (/api/cron/breaking) — the ONLY lane that can publish unreviewed.
# It takes confirmed events only: a rate decision already taken or a macro print
# already released, first-party or corroborated by two outlets, in settled
# language, with a figure. Anything else, and any brief that fails due diligence,
# is filed to the Review Queue instead.
# Default is OFF (review-only). Set explicitly to "true" to allow live autopublish.
# BREAKING_AUTOPUBLISH="false"
# Max briefs per run (default 2, capped at 5).
# BREAKING_PER_RUN="2"
# How recent the news must be to count as breaking, in minutes (default 90).
# BREAKING_MAX_AGE_MINUTES="90"
# Newsworthiness needed to publish unreviewed (default 70 vs 45 for review).
# BREAKING_MIN_SCORE="70"
# Minimum due-diligence score to publish unreviewed (default 80).
# BREAKING_DD_MIN_SCORE="80"
# Optional: Slack Incoming Webhook to ping when new drafts await review.
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/XXX/YYY/ZZZ"
# Optional: base site URL used to build the review-queue link in that Slack ping.
# SITE_URL="https://your-app.vercel.app"

# Resend (optional, for newsletter delivery)
# RESEND_API_KEY="re_..."

# Seed account passwords (used by `npm run db:seed`)
# Generate unique values for each account; never commit real passwords.
# Each must be at least 16 characters with upper/lowercase letters, a number,
# and a special character.
SEED_ADMIN_PASSWORD="generate-a-strong-unique-password"
SEED_EDITOR_PASSWORD="generate-a-strong-unique-password"
SEED_AUTHOR_PASSWORD="generate-a-strong-unique-password"
